#!/usr/bin/env bash
# frame-record-mix – the sound for a screen recording (services/Recorder.qml).
#
# wf-recorder records one PipeWire source. To record several at once, each at its own level
# (the GoXLR's System, Game, Chat, Music, the mic …), this makes a sink "frame-rec" and loops
# every chosen source into it; wf-recorder then records frame-rec.monitor.
#
#   frame-record-mix start <source>=<percent> ...   e.g. alsa_output…Speaker__sink.monitor=100
#                                                   prints the source to record: frame-rec.monitor
#   frame-record-mix tracks <dir> <key>|<source>|<percent> ...
#                                                   also records every source on its own, one
#                                                   <key>.flac each plus tracks.json, for the
#                                                   recording editor (editor/)
#   frame-record-mix stop                           unloads everything, ends the tracks
#
# The module ids are kept in $XDG_RUNTIME_DIR/frame-rec.modules, the track recorders in
# frame-rec.tracks; stop also removes leftovers from a recording that never ended (the shell
# crashed).
set -euo pipefail

SINK=frame-rec
STATE="${XDG_RUNTIME_DIR:-/tmp}/frame-rec.modules"
TRACKS="${XDG_RUNTIME_DIR:-/tmp}/frame-rec.tracks"

die() {
    echo "frame-record-mix: $*" >&2
    exit 1
}

# Loopbacks and null sinks named frame-rec that nobody cleaned up
leftovers() {
    pactl list short modules 2>/dev/null | awk -v s="$SINK" '($2 == "module-null-sink" && index($0, "sink_name=" s)) || ($2 == "module-loopback" && index($0, "sink=" s)) { print $1 }'
}

cmd_stop() {
    local id pid pids=()
    { [[ -r $STATE ]] && cat "$STATE"; leftovers; } | sort -u | while read -r id; do
        [[ -n $id ]] && pactl unload-module "$id" 2>/dev/null || true
    done
    rm -f "$STATE"
    # parecord finishes its FLAC file on SIGINT; give them two seconds, then they go
    if [[ -r $TRACKS ]]; then
        while read -r pid; do
            [[ $pid =~ ^[0-9]+$ ]] && kill -INT "$pid" 2>/dev/null && pids+=("$pid")
        done <"$TRACKS"
        for _ in $(seq 1 20); do
            local alive=0
            for pid in "${pids[@]}"; do kill -0 "$pid" 2>/dev/null && alive=1; done
            ((alive)) || break
            sleep 0.1
        done
        for pid in "${pids[@]}"; do kill -TERM "$pid" 2>/dev/null || true; done
        rm -f "$TRACKS"
    fi
}

# One parecord per source, started before the picture; tracks.json says when each began
# (milliseconds since 1970), so the editor can line them up with the video
cmd_tracks() {
    local dir=${1:-}
    [[ -n $dir ]] || die "tracks: name the folder"
    shift
    (($#)) || die "tracks: name at least one source as <key>|<source>|<percent>"
    command -v parecord >/dev/null || die "parecord is missing (libpulse)"
    mkdir -p "$dir"
    : >"$TRACKS"
    local item key source percent name started list='[]'
    for item in "$@"; do
        IFS='|' read -r key source percent <<<"$item"
        [[ -n $key && -n $source ]] || die "not <key>|<source>|<percent>: $item"
        [[ $percent =~ ^[0-9]+$ ]] || percent=100
        # "stream mix" → stream-mix.flac
        name=$(tr -c 'A-Za-z0-9_\n-' '-' <<<"$key")
        started=$(date +%s%3N)
        parecord --device="$source" --file-format=flac "$dir/$name.flac" </dev/null >/dev/null 2>&1 &
        echo "$!" >>"$TRACKS"
        list=$(jq -c --arg k "$key" --arg f "$name.flac" --arg s "$source" \
            --argjson t "$started" --argjson l "$percent" \
            '. + [{ key: $k, file: $f, source: $s, started: $t, level: ($l / 100) }]' <<<"$list")
    done
    jq -n --argjson tracks "$list" '{ version: 1, tracks: $tracks }' >"$dir/tracks.json"
}

cmd_start() {
    (($#)) || die "start: name at least one source as <source>=<percent>"
    command -v pactl >/dev/null || die "pactl is missing (libpulse)"
    cmd_stop
    local id source percent idx
    id=$(pactl load-module module-null-sink "sink_name=$SINK" "sink_properties=device.description=frameshell\\ recording")
    echo "$id" >"$STATE"
    for item in "$@"; do
        source=${item%=*}
        percent=${item##*=}
        [[ $source == "$item" ]] && percent=100
        [[ $percent =~ ^[0-9]+$ ]] || die "not a percentage: $percent"
        # latency_msec keeps the sources in step with each other and the picture
        if ! id=$(pactl load-module module-loopback "source=$source" "sink=$SINK" latency_msec=40 2>/dev/null); then
            echo "frame-record-mix: could not loop $source, left out" >&2
            continue
        fi
        echo "$id" >>"$STATE"
        # The loopback is a stream into the sink; its volume is the channel's level
        idx=$(pactl -f json list sink-inputs 2>/dev/null \
            | jq -r --arg m "$id" 'first(.[] | select((.owner_module | tostring) == $m) | .index) // empty' 2>/dev/null || true)
        [[ -n $idx ]] && pactl set-sink-input-volume "$idx" "${percent}%" 2>/dev/null || true
    done
    echo "$SINK.monitor"
}

case ${1:-} in
    start) shift; cmd_start "$@" ;;
    tracks) shift; cmd_tracks "$@" ;;
    stop) cmd_stop ;;
    *) die "usage: frame-record-mix start <source>=<percent> ... | tracks <dir> <key>|<source>|<percent> ... | stop" ;;
esac
