pragma Singleton

import QtQuick
import Quickshell

// {{name}} palette, fonts, sizes and timings for every module.
// Generated by `frame theme` from themes/<theme>.json; edit
// themes/templates/quickshell/.config/quickshell/config/Theme.qml instead.
// Quickshell reloads on its own when the file changes. Sizes are pixels at 1080p.
Singleton {
    readonly property string name: "{{name}}"

    readonly property color bg: "{{colors.bg}}"
    readonly property color surface: "{{colors.surface}}"
    readonly property color surface2: "{{colors.surface2}}"
    readonly property color shadow: "{{colors.shadow}}"
    readonly property color primary: "{{colors.primary}}"
    readonly property color secondary: "{{colors.secondary}}"
    readonly property color accent: "{{colors.accent}}"
    readonly property color text: "{{colors.text}}"
    readonly property color textDim: "{{colors.textDim}}"
    readonly property color muted: "{{colors.muted}}"
    readonly property color frame: "{{colors.frame}}"
    readonly property color border: "{{colors.surface2}}"
    readonly property color danger: "{{colors.danger}}"
    readonly property color warn: "{{colors.warn}}"
    readonly property color ok: "{{colors.ok}}"

    readonly property string font: "{{fonts.ui}}"
    // Nerd Font build of the same face, for icons (weather, media, keyboard)
    readonly property string iconFont: "{{fonts.icons}}"

    readonly property QtObject size: QtObject {
        readonly property int small: 15
        readonly property int normal: 17
        readonly property int large: 26
        readonly property int clock: 190
    }

    readonly property QtObject anim: QtObject {
        readonly property int fast: 200
        readonly property int normal: 450
        readonly property int slow: 900
    }
}
