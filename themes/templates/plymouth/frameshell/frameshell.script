# frameshell boot splash ({{name}}). Generated by `frame theme`; edit
# themes/templates/plymouth/frameshell/frameshell.script instead. `frame boot` installs it.
#
# One frame in the middle of the screen like the shell's panels: the wordmark in its top
# border, a thin progress line and a status line that turns into the disk password prompt
# (LUKS). The 1x1 pictures (line, fill, track, bg) are drawn by frame in the theme colors.

fun color(r, g, b) {
    c.r = r / 255;
    c.g = g / 255;
    c.b = b / 255;
    return c;
}

bg = color({{colors.bg|rgb}});
fg = color({{colors.text|rgb}});
dim = color({{colors.muted|rgb}});
hi = color({{colors.primary|rgb}});

Window.SetBackgroundTopColor(bg.r, bg.g, bg.b);
Window.SetBackgroundBottomColor(bg.r, bg.g, bg.b);

FONT = "JetBrains Mono";

screen_x = Window.GetX();
screen_y = Window.GetY();
screen_w = Window.GetWidth();
screen_h = Window.GetHeight();

box_w = 520;
box_h = 140;
box_x = screen_x + Math.Int((screen_w - box_w) / 2);
box_y = screen_y + Math.Int((screen_h - box_h) / 2);

line = Image("line.png");
fill = Image("fill.png");
track = Image("track.png");
paper = Image("bg.png");

fun edge(x, y, w, h) {
    s = Sprite(line.Scale(w, h));
    s.SetPosition(x, y, 10);
    return s;
}

edge_top = edge(box_x, box_y, box_w, 1);
edge_bottom = edge(box_x, box_y + box_h - 1, box_w, 1);
edge_left = edge(box_x, box_y, 1, box_h);
edge_right = edge(box_x + box_w - 1, box_y, 1, box_h);

# The wordmark sits in the top border, on a patch of background that hides the line
label_image = Image.Text(" frameshell ", hi.r, hi.g, hi.b, 1, FONT + " Bold 14");
label_y = box_y - Math.Int(label_image.GetHeight() / 2);
label_patch = Sprite(paper.Scale(label_image.GetWidth(), label_image.GetHeight()));
label_patch.SetPosition(box_x + 24, label_y, 15);
label = Sprite(label_image);
label.SetPosition(box_x + 24, label_y, 20);

# Progress: a dim track and the primary color growing over it
bar_x = box_x + 32;
bar_y = box_y + 58;
bar_w = box_w - 64;
bar_track = Sprite(track.Scale(bar_w, 2));
bar_track.SetPosition(bar_x, bar_y, 10);
bar_fill = Sprite(fill.Scale(1, 2));
bar_fill.SetPosition(bar_x, bar_y, 11);

fun progress_callback(duration, progress) {
    w = Math.Int(bar_w * progress);
    if (w < 1)
        w = 1;
    bar_fill.SetImage(fill.Scale(w, 2));
}
Plymouth.SetBootProgressFunction(progress_callback);

# Status line under it: what is happening, or the password prompt
status = Sprite();
status.SetPosition(bar_x, box_y + 84, 10);

fun say(text, c) {
    status.SetImage(Image.Text(text, c.r, c.g, c.b, 1, FONT + " 12"));
}
say("starting", dim);

fun message_callback(text) {
    say(text, dim);
}
Plymouth.SetMessageFunction(message_callback);

fun password_callback(prompt, bullets) {
    dots = "";
    i = 0;
    while (i < bullets) {
        dots = dots + "•";
        i++;
    }
    if (prompt == "")
        prompt = "disk password";
    say("> " + prompt + "  " + dots + "_", fg);
}
Plymouth.SetDisplayPasswordFunction(password_callback);

fun question_callback(prompt, entry) {
    say("> " + prompt + "  " + entry + "_", fg);
}
Plymouth.SetDisplayQuestionFunction(question_callback);

fun normal_callback() {
    say("starting", dim);
}
Plymouth.SetDisplayNormalFunction(normal_callback);

fun quit_callback() {
    say("", dim);
}
Plymouth.SetQuitFunction(quit_callback);
